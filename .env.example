# ============================================================
#  Root Environment Variables — 918822019.github.io
# ============================================================
# Copy this file to .env in each relevant directory as needed.
# Never commit actual .env files to git.

# --- ModelScope (for data download/upload & model download) ---
# Used by: scripts/data/modelscope_reader.py, upload_data.ps1, sync_models.ps1
# Get token: https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_TOKEN=your_modelscope_token_here

# --- LLM Provider (SiliconFlow / OpenAI) ---
# Used by: project/book_search/src/llm/
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=Qwen/Qwen3-8B

EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5

RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_KEY=your_api_key_here
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# --- Request Settings ---
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# --- llama.cpp UI ---
# Used by: project/quant/llama.cpp/tools/ui/
VITE_PUBLIC_APP_NAME=llama-ui
