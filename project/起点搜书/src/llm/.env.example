# ==================== LLM 配置 ====================
# LLM API 基础 URL
LLM_BASE_URL=https://api.openai.com/v1

# LLM API 密钥
LLM_API_KEY=your_api_key_here

# LLM 模型名称
LLM_MODEL_NAME=gpt-3.5-turbo


# ==================== Embedding 配置 ====================
# Embedding API 基础 URL
EMBEDDING_BASE_URL=https://api.openai.com/v1

# Embedding API 密钥
EMBEDDING_API_KEY=your_api_key_here

# Embedding 模型名称
EMBEDDING_MODEL_NAME=text-embedding-ada-002


# ==================== Reranker 配置 ====================
# Reranker API 基础 URL（如果与 Embedding 共用可留空）
RERANKER_BASE_URL=

# Reranker API 密钥
RERANKER_API_KEY=

# Reranker 模型名称
RERANKER_MODEL_NAME=bge-reranker-base


# ==================== 通用配置 ====================
# 请求超时时间（秒）
REQUEST_TIMEOUT=30

# 最大重试次数
MAX_RETRIES=3
